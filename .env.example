# Application Config
PORT=8000
HOST=0.0.0.0

# Database Credentials
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=fastapi_poc_db
DB_HOST=database
DB_PORT=5432
FORWARD_DB_PORT=5433

# Full Database URL (used by SQLAlchemy)
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@database:5432/fastapi_poc_db

# pgAdmin Config
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
PGADMIN_FORWARD_PORT=8080
